{
  "name": "@jeremyfellaz/theseus",
  "version": "0.1.0",
  "description": "Distribution parity tests for packaged CLIs.",
  "type": "module",
  "bin": {
    "theseus": "./bin/theseus.js"
  },
  "files": [
    "bin",
    "dist/src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/*.test.js",
    "verify": "npm run typecheck && npm test",
    "corpus:live": "npm run build && node scripts/run-corpus.mjs",
    "prepack": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JeremyDev87/theseus.git"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
