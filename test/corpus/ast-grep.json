{
  "version": 1,
  "bin": "ast-grep",
  "profiles": {
    "default": { "installArgs": [] },
    "noOptional": { "installArgs": ["--omit=optional"] }
  },
  "probes": [
    {
      "id": "help",
      "argv": ["--help"],
      "timeoutMs": 10000,
      "compare": ["exit", "stdout", "stderr", "runtime"]
    },
    {
      "id": "version",
      "argv": ["--version"],
      "timeoutMs": 10000,
      "compare": ["exit", "stdout", "stderr"]
    }
  ]
}
